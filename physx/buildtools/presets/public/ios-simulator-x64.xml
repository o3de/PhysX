<?xml version="1.0" encoding="utf-8"?>
<preset name="ios-simulator-x64" comment="O3DE ios-simulator-x64 CPU SDK">
  <platform targetPlatform="ios64" compiler="xcode" />
  <CMakeSwitches>
    <cmakeSwitch name="PX_BUILDSNIPPETS" value="False" />
    <cmakeSwitch name="PX_BUILDPVDRUNTIME" value="False" />
    <cmakeSwitch name="PX_GENERATE_GPU_PROJECTS" value="False" />
    <cmakeSwitch name="PX_GENERATE_STATIC_LIBRARIES" value="True" />
  </CMakeSwitches>
  <CMakeParams>
    <cmakeParam name="TARGET_BUILD_PLATFORM" value="ios" />
    <cmakeParam name="PX_OUTPUT_ARCH" value="x86" />
    <cmakeParam name="CMAKE_SYSTEM_NAME" value="iOS" />
    <cmakeParam name="CMAKE_OSX_ARCHITECTURES" value="x86_64" />
    <cmakeParam name="CMAKE_OSX_SYSROOT" value="iphonesimulator" />
    <cmakeParam name="CMAKE_OSX_DEPLOYMENT_TARGET" value="14.0" />
    <cmakeParam name="CMAKE_INSTALL_PREFIX" value="install/ios-simulator-x64/PhysX" />
  </CMakeParams>
</preset>
